{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "club-auth-skeleton",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "ORG_EMAIL_DOMAIN": ""
  }
}
